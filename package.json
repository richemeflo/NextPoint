{
  "name": "nextpoint",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "lint": "npm run mobile:lint",
    "mobile": "npm --prefix apps/mobile run start --",
    "mobile:web": "npm --prefix apps/mobile run web",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:typecheck": "node node_modules/typescript/bin/tsc --project apps/mobile/tsconfig.json --noEmit",
    "shared:typecheck": "node node_modules/typescript/bin/tsc --project packages/shared/tsconfig.json --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:db:start": "supabase db start",
    "supabase:db:reset": "supabase db reset",
    "supabase:test:db": "supabase test db",
    "supabase:types": "supabase gen types typescript --local > packages/shared/src/types/database.types.ts",
    "test": "npm run test:env && npm run test:auth && npm run test:security",
    "test:security": "tsx --test apps/mobile/src/features/auth/password-recovery.test.ts apps/mobile/src/features/students/student-activation-link.test.ts apps/mobile/src/lib/supabase/secure-storage-core.test.ts",
    "test:password-recovery": "tsx --test apps/mobile/src/features/auth/password-recovery.test.ts",
    "test:student-list-pagination": "tsx --test apps/mobile/src/features/students/student-list-pagination.test.ts",
    "test:theme-preference": "tsx --test apps/mobile/src/features/theme/theme-preference.test.ts",
    "test:env": "node scripts/verify-env-examples.mjs",
    "test:auth": "tsx --test packages/shared/src/contracts/auth.test.ts packages/shared/src/contracts/availability-range.test.ts packages/shared/src/contracts/booking.test.ts packages/shared/src/contracts/coach-profile.test.ts packages/shared/src/contracts/coach-stats.test.ts packages/shared/src/contracts/lesson-pack.test.ts packages/shared/src/contracts/messaging.test.ts packages/shared/src/contracts/notification.test.ts packages/shared/src/contracts/pricing-rate.test.ts packages/shared/src/contracts/student-account.test.ts packages/shared/src/contracts/student-edge-function.test.ts packages/shared/src/contracts/student-history.test.ts packages/shared/src/contracts/student-private-note.test.ts packages/shared/src/contracts/student-profile.test.ts packages/shared/src/domain/scheduling-time.test.ts apps/mobile/src/i18n/index.test.ts apps/mobile/src/features/auth/access-policy.test.ts apps/mobile/src/features/auth/auth-error.test.ts apps/mobile/src/features/auth/auth-session-transition.test.ts apps/mobile/src/features/auth/role-service.test.ts apps/mobile/src/features/bookings/booking-error.test.ts apps/mobile/src/features/bookings/booking-mutation-lock.test.ts apps/mobile/src/features/bookings/coach-booking-pricing.test.ts apps/mobile/src/features/mutations/mutation-lock.test.ts apps/mobile/src/features/notifications/notification-pagination.test.ts apps/mobile/src/features/pricing/pricing-student-search.test.ts apps/mobile/src/features/profiles/option-group-navigation.test.ts apps/mobile/src/features/stats/coach-stats-error.test.ts apps/mobile/src/features/stats/coach-stats-format.test.ts apps/mobile/src/features/stats/coach-stats-view.test.ts apps/mobile/src/features/students/student-history-pagination.test.ts apps/mobile/src/features/students/student-history-view.test.ts apps/mobile/src/features/students/student-list-filters.test.ts apps/mobile/src/features/students/student-private-note-editor.test.ts apps/mobile/src/features/lesson-packs/lesson-pack-pagination.test.ts apps/mobile/src/features/lesson-packs/lesson-pack-request.test.ts apps/mobile/src/features/lesson-packs/lesson-pack-state.test.ts apps/mobile/src/features/scheduling/agenda-grid-selection.test.ts apps/mobile/src/features/scheduling/availability-mutation-scope.test.ts apps/mobile/src/features/scheduling/booking-request-time.test.ts apps/mobile/src/features/scheduling/coach-planning-visibility.test.ts apps/mobile/src/features/scheduling/latest-planning-request.test.ts apps/mobile/src/features/scheduling/student-agenda-load.test.ts apps/mobile/src/features/scheduling/planning-window.test.ts apps/mobile/src/lib/supabase/supabase-url.test.ts",
    "test:auth:roles": "node scripts/verify-auth-roles.mjs",
    "test:coach-profiles": "node scripts/verify-coach-profiles.mjs",
    "test:student-coach-relationships": "node scripts/verify-student-coach-relationships.mjs",
    "test:student-list-access": "node scripts/verify-student-list-access.mjs",
    "test:student-detail-access": "node scripts/verify-student-detail-access.mjs",
    "test:student-private-notes": "node scripts/verify-student-private-notes.mjs",
    "test:lesson-packs": "node scripts/verify-lesson-packs.mjs",
    "test:availability-ranges": "node scripts/verify-availability-ranges.mjs",
    "test:manual-student-creation": "node scripts/verify-manual-student-creation.mjs",
    "test:pricing-rates": "node scripts/verify-pricing-rates.mjs",
    "test:student-profiles": "node scripts/verify-student-profiles.mjs",
    "test:typecheck": "node node_modules/typescript/bin/tsc --project tsconfig.tests.json --noEmit",
    "typecheck": "npm run mobile:typecheck && npm run shared:typecheck && npm run test:typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "expo": "57.0.18",
    "expo-constants": "57.0.16",
    "expo-font": "57.0.2",
    "expo-router": "57.0.17",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3",
    "supabase": "^2.107.0",
    "tsx": "^4.22.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
